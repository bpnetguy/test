{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {
      "type": "ellipse",
      "id": "flex-grid-circle",
      "x": 100,
      "y": 120,
      "width": 240,
      "height": 200,
      "strokeColor": "#000000",
      "backgroundColor": "#4a90d9",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 30,
      "radiusX": 120,
      "radiusY": 100
    },
    {
      "type": "text",
      "id": "flex-grid-label",
      "x": 140,
      "y": 80,
      "width": 120,
      "height": 24,
      "text": "Flex Grid",
      "fontFamily": 1,
      "fontSize": 18,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "type": "text",
      "id": "program-thread",
      "x": 120,
      "y": 180,
      "width": 140,
      "height": 20,
      "text": "Program Thread",
      "fontFamily": 1,
      "fontSize": 14,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "typescript",
      "x": 120,
      "y": 210,
      "width": 80,
      "height": 20,
      "text": "TypeScript",
      "fontFamily": 1,
      "fontSize": 14,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "ellipse",
      "id": "other-grids-circle",
      "x": 260,
      "y": 120,
      "width": 240,
      "height": 200,
      "strokeColor": "#000000",
      "backgroundColor": "#50c878",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 30,
      "radiusX": 120,
      "radiusY": 100
    },
    {
      "type": "text",
      "id": "other-grids-label",
      "x": 400,
      "y": 80,
      "width": 120,
      "height": 24,
      "text": "Other Grids",
      "fontFamily": 1,
      "fontSize": 18,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "type": "text",
      "id": "main-thread",
      "x": 360,
      "y": 180,
      "width": 100,
      "height": 20,
      "text": "Main Thread",
      "fontFamily": 1,
      "fontSize": 14,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "brightscript",
      "x": 360,
      "y": 210,
      "width": 90,
      "height": 20,
      "text": "BrightScript",
      "fontFamily": 1,
      "fontSize": 14,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "overlap-label",
      "x": 280,
      "y": 240,
      "width": 60,
      "height": 20,
      "text": "Label",
      "fontFamily": 1,
      "fontSize": 14,
      "textAlign": "center",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "overlap-poster",
      "x": 280,
      "y": 265,
      "width": 70,
      "height": 20,
      "text": "Poster",
      "fontFamily": 1,
      "fontSize": 14,
      "textAlign": "center",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "overlap-rectangle",
      "x": 280,
      "y": 290,
      "width": 100,
      "height": 20,
      "text": "Rectangle",
      "fontFamily": 1,
      "fontSize": 14,
      "textAlign": "center",
      "verticalAlign": "top"
